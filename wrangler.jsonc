{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ohmyho-web-production",
  "account_id": "9e753b729403274e3c62ea1ffd4fddd7",
  "main": "src/worker-main.ts",
  "compatibility_date": "2026-09-05",
  "workers_dev": false,
  "preview_urls": false,
  // The platform keeps ohmyho.st/releases/*, client-release.json, omh.st and the project
  // addresses; Cloudflare resolves its path routes before this host route.
  "routes": [
    { "pattern": "ohmyho.st", "custom_domain": true },
    { "pattern": "www.ohmyho.st", "custom_domain": true },
  ],
  "services": [{ "binding": "CONTROL_API", "service": "ohmyho-control-api-production" }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
  },
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
}
