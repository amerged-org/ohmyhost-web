{
  "name": "@ohmyhost/public-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "ohmyhost": {
    "deployment": "production",
    "fakeProviderBoundary": {
      "typescriptProject": "tsconfig.build.json",
      "artifactRoot": "dist",
      "entrypoints": [
        "src/worker-main.ts"
      ],
      "bundles": [
        {
          "entrypoint": "src/worker-main.ts",
          "metafile": "dist/worker-bundle/metafile.json"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/prepare-pages.mjs && tsc --project tsconfig.build.json && wrangler deploy --dry-run --outdir dist/worker-bundle --metafile dist/worker-bundle/metafile.json --config wrangler.jsonc",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "node scripts/prepare-pages.mjs && vitest run --root ../.. apps/public-site/test",
    "pages:prepare": "node scripts/prepare-pages.mjs"
  },
  "devDependencies": {
    "wrangler": "4.125.0"
  },
  "dependencies": {
    "@ohmyhost/agent-skills": "workspace:*",
    "marked": "18.0.12"
  }
}
